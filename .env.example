# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Browser origin allowed during local
# split frontend/API development.
#
# Production uses the same domain:
# https://uhp.needacabplus.app
FRONTEND_ORIGIN=http://localhost:5173

# SQLite data directory.
#
# Coolify production:
# DATA_DIR=/app/data
DATA_DIR=./data

# Required in production for Autocab
# webhook authentication.
#
# Never commit the real secret.
AUTOCAB_WEBHOOK_SECRET=

# Server-side Autocab booking submission.
#
# Never expose the subscription key in
# a VITE_ variable or browser code.
AUTOCAB_BOOKING_API_URL=https://autocab-api.azure-api.net
AUTOCAB_SUBSCRIPTION_KEY=
AUTOCAB_COMPANY_ID=1

# Standard UHP hospital account.
AUTOCAB_UHP_CUSTOMER_ID=2139

# Christmas staff account.
AUTOCAB_UHP_XMAS_CUSTOMER_ID=2023

# Server-side MapTiler geocoding key.
#
# Used only by the authenticated address-search proxy.
# Never expose this value in a VITE_ variable.
MAPTILER_GEOCODING_API_KEY=

# Server-side OSRM-compatible routing service.
#
# Development defaults to the public OSRM demo
# service when this is blank.
#
# Coolify production:
# OSRM_BASE_URL=http://uhp-osrm:5000
#
# This URL is server-side only and is not exposed
# to the browser bundle.
OSRM_BASE_URL=

# Map tile service.
#
# Development defaults to OpenStreetMap public
# tiles when this is blank.
#
# Production should use an approved or
# self-hosted tile endpoint.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Comma-separated work email domains allowed to start
# restricted Special Transport self-service registration.
# Example:
# STAFF_TRANSPORT_ALLOWED_EMAIL_DOMAINS=nhs.net,plymouthhospitals.nhs.uk
STAFF_TRANSPORT_ALLOWED_EMAIL_DOMAINS=
