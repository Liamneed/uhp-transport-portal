# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Browser origin allowed during local
# split frontend/API development.
#
# Production uses the same domain:
# https://uhp.needacabplus.app
FRONTEND_ORIGIN=http://localhost:5173

# SQLite data directory.
#
# Coolify production:
# DATA_DIR=/app/data
DATA_DIR=./data

# Required in production for Autocab
# webhook authentication.
#
# Never commit the real secret.
AUTOCAB_WEBHOOK_SECRET=

# OSRM-compatible routing service.
#
# Development defaults to the public OSRM demo
# service when this is blank.
#
# Production should use an approved or
# self-hosted routing endpoint. If omitted in
# production, the map safely falls back to the
# booked stop-to-stop route.
VITE_ROUTING_BASE_URL=

# Map tile service.
#
# Development defaults to OpenStreetMap public
# tiles when this is blank.
#
# Production should use an approved or
# self-hosted tile endpoint.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
