# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Browser origin allowed during local
# split frontend/API development.
#
# Production uses the same domain:
# https://uhp.needacabplus.app
FRONTEND_ORIGIN=http://localhost:5173

# SQLite data directory.
#
# Coolify production:
# DATA_DIR=/app/data
DATA_DIR=./data

# Required in production for Autocab
# webhook authentication.
#
# Never commit the real secret.
AUTOCAB_WEBHOOK_SECRET=
